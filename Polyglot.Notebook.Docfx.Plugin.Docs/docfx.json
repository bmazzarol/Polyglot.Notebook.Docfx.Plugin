{
    "metadata": [],
    "build": {
        "content": [
            {
                "files": [
                    "toc.yml",
                    "index.ipynb",
                    "getting-started.ipynb"
                ]
            }
        ],
        "resource": [
            {
                "files": [
                    "images/**"
                ]
            }
        ],
        "postProcessors": [
            "ExtractSearchIndex"
        ],
        "template": [
            "default",
            "modern",
            "template"
        ],
        "output": "_site",
        "globalMetadata": {
            "_appName": "Polyglot Notebook Docfx Plugin",
            "_appLogoPath": "images/notebook-icon.png",
            "_appFaviconPath": "images/favicon.ico",
            "_appFooter": "Part of <a href='https://github.com/bmazzarol'>bmazzarol</a> - built with <a href='https://dotnet.github.io/docfx'>docfx</a>",
            "_disableBreadcrumb": true,
            "_disableTocFilter": true,
            "_appLogoUrl": "https://bmazzarol.github.io/bmazzarol/"
        }
    }
}
